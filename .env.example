# Anthropic Admin API Key (for backend server)
# Get your admin API key from: https://console.anthropic.com/settings/admin-keys
ANTHROPIC_ADMIN_API_KEY=your_admin_api_key_here

# Optional: Backend server port (default: 3001)
# PORT=3001

# Optional: Frontend API URL (default: http://localhost:3001/api)
# VITE_API_URL=http://localhost:3001/api
